# Database
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Instagram API Configuration
INSTAGRAM_ACCESS_TOKEN=your_long_lived_user_access_token_here
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id_here
FACEBOOK_PAGE_ID=your_facebook_page_id_here

# Facebook App Security
FACEBOOK_APP_SECRET=your_facebook_app_secret_here
WEBHOOK_VERIFY_TOKEN=create_a_random_string_for_verification

# Notes:
# - Get Instagram Access Token from Facebook Graph API Explorer
# - Access tokens expire after 60 days and need to be refreshed
# - Webhook verify token should match what you set in Facebook App dashboard
# - App secret is found in Facebook App settings under "Basic"
